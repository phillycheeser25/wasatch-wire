---
layout: base.njk
title: Dynasty Top 25
navActive: rankings
---
<div class="container"><div class="page-header"><p class="eyebrow">THE NATIONAL PICTURE</p><h1 class="page-title">Dynasty Top 25</h1><p class="page-subtitle">Season {{ site.season }} · {{ rankings.lastUpdated }}</p></div>
<div class="team-status-grid">{% for team in rankings.ourTeams %}<div class="team-status {{ team.name | lower }}"><span>THE WASATCH TEAMS</span><h2>No. {{ team.rank }} {{ team.name }}</h2><p>{{ team.record }} overall</p></div>{% endfor %}</div>
<p class="data-note">{{ rankings.note }}</p><div class="section-label">The national order <span>{{ rankings.lastUpdated }}</span></div><div class="table-scroll"><table class="data-table poll-table"><thead><tr><th>Rank</th><th>Team</th><th>Conference</th><th>Record</th><th>Movement</th></tr></thead><tbody>
{% for team in rankings.ap %}<tr class="{% if team.name == 'Utah' %}team-utah{% elif team.name == 'BYU' %}team-byu{% endif %}"><td>{{ team.rank }}</td><td><span class="team-dot" style="background:{{ team.color }}"></span>{{ team.name }}</td><td>{{ team.conf }}</td><td>{{ team.record }}</td><td>{% if team.trend == none %}New{% elif team.trend > 0 %}↑ {{ team.trend }}{% elif team.trend < 0 %}↓ {{ 0 - team.trend }}{% else %}—{% endif %}</td></tr>{% endfor %}</tbody></table></div></div>