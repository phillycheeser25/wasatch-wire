---
layout: base.njk
navActive: home
---

{% set featuredArticle = null %}
{% for a in collections.articles %}
  {% if a.data.featured and not featuredArticle %}{% set featuredArticle = a %}{% endif %}
{% endfor %}
{% if not featuredArticle %}{% set featuredArticle = collections.articles | first %}{% endif %}
{% set recentArticles = collections.articles | limit(6) %}

<div class="container">

  {# ─── Hero Split ─── #}
  <div class="home-hero" style="margin: 0 -24px; padding: 0 24px;">
    <div class="hero-main" style="padding-left:0;">

      {% if featuredArticle %}
        <div class="hero-tag">{{ featuredArticle.data.category or "Wire" }} · {% if featuredArticle.data.week is defined %}Week {{ featuredArticle.data.week }}{% else %}{{ featuredArticle.data.date | dateDisplay }}{% endif %}</div>

        {% if featuredArticle.data.image %}
        <div class="hero-img">
          <img src="{{ featuredArticle.data.image | url }}" alt="{{ featuredArticle.data.title }}">
        </div>
        {% else %}
        <div class="hero-img-placeholder">Wasatch Wire</div>
        {% endif %}

        <h2 class="hero-headline">
          <a href="{{ featuredArticle.url | url }}" style="color:inherit;">{{ featuredArticle.data.title }}</a>
        </h2>
        {% if featuredArticle.data.deck %}
        <p class="hero-deck">{{ featuredArticle.data.deck }}</p>
        {% endif %}
        <div class="hero-byline">
          Wasatch Wire Staff
          {% if featuredArticle.data.location %}
            <div class="byline-dot"></div> {{ featuredArticle.data.location }}
          {% endif %}
        </div>

      {% else %}
        <div class="hero-tag">Wasatch Wire · Season {{ site.season }}</div>
        <div class="hero-img-placeholder">Season {{ site.season }} coverage begins soon</div>
        <h2 class="hero-headline">Wasatch Wire is live. Season {{ site.season }} starts now.</h2>
        <p class="hero-deck">Coverage of Utah Utes and BYU Cougars Big 12 dynasty. Drop screenshots in the inbox and articles go up automatically.</p>
        <div class="hero-byline">Wasatch Wire Staff</div>
      {% endif %}

    </div>

    {# ─── Right Rail ─── #}
    <div class="hero-rail">

      <div class="widget"><div class="widget-title">Around the Wasatch<a href="{{ '/scores/' | url }}">Schedules →</a></div><div class="wasatch-status utah"><span>No. 19 UTAH · 1–0</span><strong>Utah 36, Utah State 20</strong><p>Week 1 bye · Next: at Boise State</p></div><div class="wasatch-status byu"><span>No. 12 BYU · 1–0</span><strong>BYU 27, Wyoming 6</strong><p>Next: Arizona at BYU · Week 2</p></div></div>
      <div class="widget"><div class="widget-title">Our Big 12 ballot<a href="{{ '/big-12/' | url }}">All sixteen →</a></div><p class="data-note">Preseason opinion · projected conference record</p>{% for team in projections.teams | limit(4) %}<div class="ranking-row"><div class="ranking-num">{{ team.rank }}</div><div class="ranking-name">{{ team.name }}</div><div class="ranking-record">{{ team.confWins }}–{{ team.confLosses }}</div></div>{% endfor %}</div>
      <div class="widget"><div class="widget-title">Heisman Watch<a href="{{ '/heisman/' | url }}">The full board →</a></div><p class="data-note">National lead: Jeremiah Smith, Ohio State</p>{% for player in heisman.local %}<div class="radar-mini"><a href="{{ player.url | url }}">{{ player.name }}</a><span>{{ player.team }} · {{ player.line }}</span></div>{% endfor %}</div>
      {# Holy War #}
      <div class="widget">
        <div class="widget-title">Holy War series</div>
        <div class="hw-scores">
          <div class="hw-team">
            <div class="hw-team-name">Utah</div>
            <div class="hw-team-score utah">{{ holywar.utahWins }}</div>
          </div>
          <div class="hw-divider">dynasty record</div>
          <div class="hw-team">
            <div class="hw-team-name">BYU</div>
            <div class="hw-team-score byu">{{ holywar.byuWins }}</div>
          </div>
        </div>
        <a href="{{ '/holy-war/' | url }}" class="hw-link">Full rivalry page →</a>
      </div>

    </div>
  </div>

  {# ─── Latest Articles ─── #}
  <div class="home-wire">
    <div class="section-label">Latest from the wire</div>
    <div class="article-grid">
      {% for article in recentArticles %}
      <div class="article-card {% if article.data.team == 'utah' %}utah-card{% elif article.data.team == 'byu' %}byu-card{% elif article.data.team == 'national' %}national-card{% endif %} {% if 'tabloids' in article.data.tags %}tabloid-card{% endif %}">
        {% if article.data.image %}
        <div class="article-card-img">
          <img src="{{ article.data.image | url }}" alt="{{ article.data.title }}">
        </div>
        {% else %}
        <div class="article-card-img-placeholder">Wasatch Wire</div>
        {% endif %}
        <div class="article-card-body">
          <div class="article-tag {% if article.data.team %}{{ article.data.team }}{% endif %} {% if 'tabloids' in article.data.tags %}tabloids{% endif %}">
            {{ article.data.category or "Wire" }}
          </div>
          <div class="article-headline">
            <a href="{{ article.url | url }}">{{ article.data.title }}</a>
          </div>
          {% if article.data.deck %}
          <div class="article-deck">{{ article.data.deck }}</div>
          {% endif %}
          <div class="article-byline">Wasatch Wire · {% if article.data.week is defined %}Week {{ article.data.week }}{% else %}{{ article.data.date | dateDisplay }}{% endif %}</div>
        </div>
      </div>
      {% endfor %}

      {% if not recentArticles or recentArticles | length == 0 %}
      <div style="grid-column: 1/-1; color:var(--text-muted); font-size:14px; padding:24px 0;">
        No articles yet — drop screenshots in the inbox and we'll get writing.
      </div>
      {% endif %}
    </div>
  </div>

</div>
