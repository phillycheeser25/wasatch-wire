<div class="container"><div class="page-header"><p class="eyebrow">THE NEXT CHAPTER</p><h1 class="page-title">Recruiting</h1><p class="page-subtitle">Class of {{ recruiting.classYear }} · Targets across the Wasatch</p></div>
<div class="section-label">Week 3 recruiting update <span>Utah &amp; BYU</span></div><p class="data-note">{{ recruiting.note }}</p><div class="radar-grid">{% for p in recruiting.updates %}<article class="radar-card {% if p.name == 'Devante Harris' %}utah{% else %}byu{% endif %}"><p class="eyebrow">{{ p.pos }} / TOP 5 STAGE / UNCOMMITTED</p><h2>{{ p.name }}</h2><div class="radar-line">No. {{ p.nationalRank }} nationally</div><p>{{ p.hometown }} · {{ p.size }}<br>{{ p.archetype }}</p><p>{{ p.summary }}</p><p><strong>Week 3 school order:</strong> {{ p.schools | join(' → ') }}</p></article>{% endfor %}</div><p><a class="text-link" href="{{ '/articles/week3-preview/' | url }}">Read the Week 3 preview →</a></p>
<div class="section-label">The feature board <span>Earlier reporting, with current notes.</span></div>
<div class="radar-grid">{% for p in recruiting.prospects %}<article class="radar-card {% if p.pos == 'QB' %}utah{% else %}byu{% endif %}"><p class="eyebrow">{{ p.pos }} / FOUR STARS / {{ p.status }} / {{ p.asOf }}</p><h2><a href="{{ p.url | url }}">{{ p.name }}</a></h2><div class="radar-line">No. {{ p.nationalRank }} nationally · No. {{ p.positionRank }} at {{ p.pos }}</div><p>{{ p.hometown }} · {{ p.size }}<br>{{ p.archetype }}</p><p>{{ p.summary }}</p><p><strong>Feature school order:</strong> {{ p.schools | join(' → ') }}</p><a class="text-link" href="{{ p.url | url }}">Read the spotlight →</a></article>{% endfor %}</div>
