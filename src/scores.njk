---
layout: base.njk
title: Scores & Schedules
navActive: scores
---
<div class="container"><div class="page-header"><p class="eyebrow">THE SEASON ON THE FIELD</p><h1 class="page-title">Scores &amp; Schedules</h1><p class="page-subtitle">Season {{ site.season }} · Week {{ site.week }}</p></div>
{% for game in games.games %}<article class="game-result"><p class="eyebrow">WEEK {{ game.week }} / {{ game.date | dateDisplay }} / FINAL</p><div class="score-match"><div {% if game.awayScore > game.homeScore %}class="score-winner"{% endif %}><span>{% if game.awayRank %}No. {{ game.awayRank }} {% endif %}{{ game.away }}</span><strong>{{ game.awayScore }}</strong></div><span class="score-divider">AT</span><div {% if game.homeScore > game.awayScore %}class="score-winner"{% endif %}><span>{% if game.homeRank %}No. {{ game.homeRank }} {% endif %}{{ game.home }}</span><strong>{{ game.homeScore }}</strong></div></div>
<div class="table-scroll"><table class="data-table quarter-table"><thead><tr><th>Team</th><th>1</th><th>2</th><th>3</th><th>4</th><th>Final</th></tr></thead><tbody><tr><td>{{ game.away }}</td>{% for q in game.awayQuarters %}<td>{{ q }}</td>{% endfor %}<td>{{ game.awayScore }}</td></tr><tr><td>{{ game.home }}</td>{% for q in game.homeQuarters %}<td>{{ q }}</td>{% endfor %}<td>{{ game.homeScore }}</td></tr></tbody></table></div><a class="text-link" href="{{ game.article | url }}">Read the game story →</a>
{% if game.playerOfGame %}<p><strong>Player of the game:</strong> {{ game.playerOfGame.name }} · {{ game.playerOfGame.line }}</p>{% endif %}<div class="boxscore-strip">{% for leader in game.leaders %}<span><b>{{ leader.value }}</b>{{ leader.label }}</span>{% endfor %}</div></article>{% endfor %}
<p class="data-note">Utah is 2–0 after winning at Boise State. BYU is 1–0 entering its Week 2 game against Arizona.</p>
<div class="section-label">Week 1 national scoreboard</div><div class="table-scroll"><table class="data-table"><thead><tr><th>Away</th><th>Score</th><th>Home</th><th>Score</th></tr></thead><tbody>{% for g in week1.scores %}<tr><td>{{ g.away }}</td><td>{{ g.awayScore }}</td><td>{{ g.home }}</td><td>{{ g.homeScore }}</td></tr>{% endfor %}</tbody></table></div><p class="data-note">Featured national results · Week 1.</p><div class="schedule-grid">{% for team in schedules.teams %}<section><div class="section-label">{{ team.name }} schedule</div><div class="table-scroll"><table class="data-table schedule-table"><thead><tr><th>Week</th><th>Date</th><th>Opponent</th><th>Result / ET</th></tr></thead><tbody>{% for game in team.games %}<tr class="{% if game.opponent == 'Utah' or game.opponent == 'BYU' %}rivalry-row{% endif %}"><td>{{ game.week }}</td><td>{{ game.date or '—' }}</td><td>{{ game.venue }} {{ game.opponent }}</td><td>{{ game.detail or '—' }}</td></tr>{% endfor %}</tbody></table></div></section>{% endfor %}</div><p class="data-note">{{ schedules.note }}</p></div>